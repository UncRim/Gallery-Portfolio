{
  "name": "denelsen-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Denelsen Dandi's portfolio: a docs-site themed content design portfolio with hand-inked line-art scenes.",
  "scripts": {
    "gen": "node scripts/gen-pages.mjs",
    "assets": "node scripts/fetch-assets.mjs",
